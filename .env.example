# Lockerly settings. Copy to .env.local only if you need to change something:
# a fresh clone runs locally with NO .env.local, using the local Supabase stack and RustFS.
# On Vercel every value marked "required on Vercel" must be set; the app refuses to start otherwise.

# ---- General ----
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# ---- Supabase (required on Vercel) ----
# Project URL, e.g. https://<project-ref>.supabase.co. Local default: http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses row-level security: server-only, used by cron jobs alone.
# No local default: copy it from `pnpm exec supabase status` if you need it locally.
SUPABASE_SECRET_KEY=

# ---- File storage: any S3-compatible bucket (required on Vercel) ----
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com. Local default: http://localhost:9100 (RustFS)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
# R2 API token scoped to this one bucket, "Object Read & Write"
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- Scheduled jobs (required on Vercel) ----
# Vercel Cron sends this as a bearer token. Generate with: openssl rand -base64 32
CRON_SECRET=

# ---- Email (optional) ----
# Resend API key for share notifications. Unset: emails are written to the server log.
RESEND_API_KEY=
